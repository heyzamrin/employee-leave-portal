@model EmployeeLeavePortal.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Employee Leave Desk</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            background: #171E2B;
            color: #F0F3F8;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            background: #252F40;
            border: 1px solid #364255;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        }

        .logo {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #45678F;
            border-radius: 12px;
            font-size: 24px;
            margin-bottom: 22px;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 27px;
        }

        .subtitle {
            color: #A6B2C3;
            margin-bottom: 28px;
            line-height: 1.5;
        }

        label {
            display: block;
            margin: 18px 0 8px;
            font-size: 14px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            color: #F0F3F8;
            background: #1C2635;
            border: 1px solid #364255;
            border-radius: 8px;
            outline: none;
        }

        input:focus, select:focus {
            border-color: #9FC5F5;
        }

        button {
            width: 100%;
            margin-top: 25px;
            padding: 13px;
            border: none;
            border-radius: 8px;
            background: #45678F;
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #537BA8;
        }

        .error, .validation {
            color: #FF9B9B;
            font-size: 13px;
        }

        .footer {
            margin-top: 25px;
            color: #A6B2C3;
            text-align: center;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="logo">L</div>

        <h1>Welcome back</h1>

        <p class="subtitle">
            Sign in to access your Employee Leave Desk account.
        </p>

        <form asp-controller="Login"
              asp-action="LoginClick"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation"></div>

            <label asp-for="Role">Login as</label>

            <select asp-for="Role">
                <option value="Employee">Employee</option>
                <option value="Admin">Admin</option>
            </select>

            <span asp-validation-for="Role"
                  class="validation"></span>

            <label asp-for="Email">Email address</label>

            <input asp-for="Email"
                   type="email"
                   placeholder="Enter your email" />

            <span asp-validation-for="Email"
                  class="validation"></span>

            <label asp-for="Password">Password</label>

            <input asp-for="Password"
                   type="password"
                   placeholder="Enter your password" />

            <span asp-validation-for="Password"
                  class="validation"></span>

            <button type="submit">Sign in</button>

            @if (ViewBag.Error != null)
            {
                <p class="error">@ViewBag.Error</p>
            }

        </form>

        <div class="footer">
            Employee Leave Desk
        </div>

    </div>
</body>
</html>
