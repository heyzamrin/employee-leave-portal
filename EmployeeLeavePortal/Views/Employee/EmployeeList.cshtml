@model IEnumerable<EmployeeLeavePortal.Models.EmployeeClass>

@{
    ViewData["Title"] = "Employee List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var employees = Model?.ToList()
        ?? new List<EmployeeLeavePortal.Models.EmployeeClass>();
}

<div class="approval-page employee-list-only">

    <div class="approval-header">
        <div>
            <p class="approval-label">EMPLOYEE MANAGEMENT</p>
            <h2>Employee Directory</h2>
            <p class="approval-subtitle">
                View and manage your registered employee records.
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="EmployeeInsertPageLoad"
           class="register-button">
            + Register Employee
        </a>
    </div>

    <div class="approval-card">

        <div class="employee-card-heading">
            <div>
                <h3>Employee Records</h3>
                <p>Employee details and joining information</p>
            </div>

            <span class="employee-count">
                @employees.Count employees
            </span>
        </div>

        @if (employees.Count == 0)
        {
            <div class="empty-card">
                <h3>No employees yet</h3>
                <p>Register an employee to see their details here.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Employee Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Joining Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in employees)
                        {
                            <tr>
                                <td class="employee-id">
                                    #@employee.EmpId
                                </td>

                                <td class="employee-name">
                                    @employee.EmpName
                                </td>

                                <td class="employee-email">
                                    @employee.Email
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(employee.Department))
                                    {
                                        <span class="department-badge">
                                            @employee.Department
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="not-assigned">
                                            Not assigned
                                        </span>
                                    }
                                </td>

                                <td>
                                    @employee.JoiningDate.ToString("dd MMM yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="employee-footer">
        Employee Leave Portal · Employee Management
    </div>

</div>

<style>
