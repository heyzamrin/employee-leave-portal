@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Admin Registration Requests";
}

<div class="approval-page">
    <div class="approval-header">
        <div>
            <p class="approval-label">ADMINISTRATION</p>
            <h2>Admin Registration Requests</h2>
            <p class="approval-subtitle">
                Review and manage requests for Admin access.
            </p>
        </div>
    </div>

    @if (TempData["ApprovalMessage"] != null)
    {
        <div class="alert-success">
            @TempData["ApprovalMessage"]
        </div>
    }

    @if (TempData["ApprovalError"] != null)
    {
        <div class="alert-error">
            @TempData["ApprovalError"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert-error">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || Model.Rows.Count == 0)
    {
        <div class="empty-card">
            <h3>No pending requests</h3>
            <p>There are currently no Admin registration requests to review.</p>
        </div>
    }
    else
    {
        <div class="approval-card">
            <div class="table-wrapper">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Admin Name</th>
                            <th>Email</th>
                            <th>Requested At</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row["RequestId"]</td>
                                <td>@row["AdminName"]</td>
                                <td>@row["Email"]</td>
                                <td>
                                    @Convert.ToDateTime(row["RequestedAt"])
                                    .ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td>
                                    <span class="pending-status">
                                        @row["Status"]
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <form asp-controller="AdminApproval"
                                              asp-action="ApproveRequest"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@row["RequestId"]" />
                                            <button type="submit"
                                                    class="approve-button">
                                                Approve
                                            </button>
                                        </form>

                                        <form asp-controller="AdminApproval"
                                              asp-action="RejectRequest"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@row["RequestId"]" />
                                            <button type="submit"
                                                    class="reject-button">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .approval-page {
        padding: 30px;
        min-height: 75vh;
        background: #f5f7fb;
        color: #172554;
        border-radius: 16px;
    }

    .approval-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .approval-label {
        color: #4f46e5;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .approval-header h2 {
        font-size: 27px;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .approval-subtitle {
        color: #64748b;
        margin: 0;
    }

    .approval-card,
    .empty-card {
        background: white;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .approval-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

        .approval-table th {
            background: #f8fafc;
            color: #475569;
            text-align: left;
            font-size: 13px;
            padding: 15px 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .approval-table td {
            padding: 16px 12px;
            border-bottom: 1px solid #edf0f5;
            font-size: 14px;
        }

    .pending-status {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .approve-button,
    .reject-button {
        border: none;
        padding: 9px 13px;
        border-radius: 7px;
        color: white;
        cursor: pointer;
        font-weight: 600;
    }

    .approve-button {
        background: #16a34a;
    }

    .reject-button {
        background: #dc2626;
    }

        .approve-button:hover,
        .reject-button:hover {
            opacity: 0.85;
        }

    .alert-success,
    .alert-error {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
    }

    .empty-card {
        text-align: center;
        padding: 55px 20px;
    }

        .empty-card p {
            color: #64748b;
        }

    @@media (max-width: 768px) {
        .approval-page {
            padding: 18px;
        }

        .approval-header h2 {
            font-size: 22px;
        }
    }
</style>
